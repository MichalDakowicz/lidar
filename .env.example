# Dedicated shared Ping backend. Obtain its publishable key privately from the
# server administrator. Never copy cloud sibling keys or a service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://ping-api.dakowicz.xyz
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Book metadata needs no credentials: Google Books' public volumes endpoint and
# Open Library are both keyless. An optional Google Books API key only raises
# the per-IP quota — leave it blank unless searches start returning 429.
EXPO_PUBLIC_GOOGLE_BOOKS_KEY=
