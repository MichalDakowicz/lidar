# The SAME Supabase project Radar and Sonar use — accounts, profiles,
# friendships and the privacy switch are the same rows in all three apps.
# Copy these two values out of ../radar/.env or ../sonar/.env verbatim.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Book metadata needs no credentials: Google Books' public volumes endpoint and
# Open Library are both keyless. An optional Google Books API key only raises
# the per-IP quota — leave it blank unless searches start returning 429.
EXPO_PUBLIC_GOOGLE_BOOKS_KEY=
